{
  "name": "vite-plugin-bare",
  "version": "0.0.0",
  "description": "Run Vite module graphs in Bare during development and package them for production.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alloc/vite-plugin-bare.git"
  },
  "bin": {
    "bare-vite": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./build": {
      "types": "./dist/build/index.d.ts",
      "import": "./dist/build/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc -p tsconfig.json --noEmit",
    "device:dev": "vite --config test/device/vite.config.ts --host 0.0.0.0",
    "device:prepare": "node test/device/prepare.mjs",
    "format": "oxlint --fix && oxfmt",
    "pretest": "npm run build",
    "pretest:watch": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@alloc/cmd-ts": "^0.17.1",
    "bare-pack": "^2.2.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@coreframe/oxc-config": "^0.1.0",
    "@types/node": "^24.3.1",
    "@types/ws": "^8.18.1",
    "bare-abort-controller": "^1.1.2",
    "bare-encoding": "^1.0.3",
    "bare-fetch": "^3.2.1",
    "bare-fs": "4.8.1",
    "bare-link": "3.3.0",
    "bare-module": "6.4.0",
    "bare-runtime": "1.31.0",
    "bare-url": "^2.5.4",
    "bare-ws": "^3.1.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tsdown": "^0.21.0",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "bare-abort-controller": ">=1",
    "bare-encoding": ">=1",
    "bare-fetch": ">=3",
    "bare-url": ">=2",
    "bare-ws": ">=2",
    "vite": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "bare-abort-controller": {
      "optional": true
    },
    "bare-encoding": {
      "optional": true
    },
    "bare-fetch": {
      "optional": true
    },
    "bare-url": {
      "optional": true
    },
    "bare-ws": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
